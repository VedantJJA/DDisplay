<Window x:Class="DDisplay.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DDisplay.App.ViewModels"
        Title="DDisplay"
        Width="780" Height="540"
        MinWidth="640" MinHeight="440"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontMain}"
        FontSize="13"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- App icon SVG embedded inline -->
                    <Viewbox Width="22" Height="22" Margin="0,0,10,0">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="1" Canvas.Top="3" Width="14" Height="10"
                                       RadiusX="2" RadiusY="2" Stroke="#4F8EF7" StrokeThickness="1.5"
                                       Fill="Transparent"/>
                            <Rectangle Canvas.Left="17" Canvas.Top="5" Width="6" Height="7"
                                       RadiusX="1" RadiusY="1" Stroke="#4F8EF7" StrokeThickness="1.5"
                                       Fill="Transparent"/>
                            <Line X1="15" Y1="8.5" X2="17" Y2="8.5" Stroke="#4F8EF7" StrokeThickness="1.5"/>
                            <Line X1="8" Y1="13" X2="8" Y2="16" Stroke="#4F8EF7" StrokeThickness="1.5"/>
                            <Line X1="4" Y1="16" X2="12" Y2="16" Stroke="#4F8EF7" StrokeThickness="1.5"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="DDisplay" Style="{StaticResource TextTitle}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,0,0">
                    <Button Content="Settings" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="Settings_Click"/>
                    <Button Content="Install VDD"
                            Click="InstallVdd_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVddInstalled}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Connection status card -->
            <Border Style="{StaticResource Card}" Grid.Column="0">
                <StackPanel>
                    <TextBlock Text="Connection" Style="{StaticResource TextTitle}" Margin="0,0,0,16"/>

                    <!-- Transport status -->
                    <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="7" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Transport" Style="{StaticResource TextCaption}" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding TransportLabel}" Style="{StaticResource TextBody}"/>
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource StatusBadge}">
                                        <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                            <Setter Property="Text" Value="Disconnected"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Text" Value="Connected"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Status text -->
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextBody}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Right: Virtual display card -->
            <Border Style="{StaticResource Card}" Grid.Column="2">
                <StackPanel>
                    <TextBlock Text="Virtual Display" Style="{StaticResource TextTitle}" Margin="0,0,0,16"/>

                    <TextBlock Text="Driver Status" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                    <Border HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StatusBadge}">
                                <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVddInstalled}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="White" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Not Installed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVddInstalled}" Value="True">
                                            <Setter Property="Text" Value="Installed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="Display Output" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                    <Border HorizontalAlignment="Left" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StatusBadge}">
                                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDisplayEnabled}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="White" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Standby (Disconnected)"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDisplayEnabled}" Value="True">
                                            <Setter Property="Text" Value="Active (Connected)"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="The display dynamically activates when your mobile device connects and automatically disconnects on exit."
                               Style="{StaticResource TextCaption}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,8">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextCaption}"/>
        </Border>
    </Grid>
</Window>
