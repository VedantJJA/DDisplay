<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DDisplay.Core</RootNamespace>
    <AssemblyName>DDisplay.Core</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- WinRT projections for Windows.Graphics.Capture as alternative to DXGI -->
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vortice.DirectX is the umbrella; Direct3D11 and DXGI are explicit for IDE resolution. -->
    <PackageReference Include="Vortice.DirectX" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <!-- Bump System.Text.Json to satisfy SharpGen.Runtime transitive dependency (requires >= 9.0.1). -->
    <PackageReference Include="System.Text.Json" Version="9.0.1" />
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DDisplay.VddControl\DDisplay.VddControl.csproj" />
  </ItemGroup>
</Project>
