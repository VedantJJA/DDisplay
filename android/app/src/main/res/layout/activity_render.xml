<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen layout for streaming. Supports both SurfaceView video and ImageView screenshot rendering. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"/>

    <ImageView
        android:id="@+id/ivScreenshot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:visibility="visible"/>

    <ImageView
        android:id="@+id/ivCursor"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_cursor"
        android:visibility="gone"
        android:elevation="10dp"/>

    <!-- Overlay HUD: tap to toggle visibility -->
    <LinearLayout
        android:id="@+id/hudOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#80000000"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvHudTransport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/tvHudResolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"/>

        <Button
            android:id="@+id/btnRefreshScreenshot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Refresh"
            android:textSize="11sp"
            android:backgroundTint="@color/color_accent"
            android:layout_marginTop="6dp"/>

        <Button
            android:id="@+id/btnStopStreaming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop"
            android:textSize="11sp"
            android:backgroundTint="@color/color_error"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

</FrameLayout>
